rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(data) {
      return signedIn() && data.landlordId == request.auth.uid;
    }

    match /landlords/{landlordId} {
      allow create: if signedIn()
        && landlordId == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.email is string;
      allow read, update, delete: if signedIn() && landlordId == request.auth.uid;
    }

    match /properties/{propertyId} {
      allow create: if owns(request.resource.data);
      allow read, delete: if owns(resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data);
    }

    match /tenants/{tenantId} {
      allow create: if owns(request.resource.data);
      allow read, delete: if owns(resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data);
    }

    match /agreements/{agreementId} {
      allow create: if owns(request.resource.data);
      allow read, delete: if owns(resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data);
    }

    match /payments/{paymentId} {
      allow create: if owns(request.resource.data);
      allow read, delete: if owns(resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data);
    }

    match /complaints/{complaintId} {
      allow create: if owns(request.resource.data);
      allow read, delete: if owns(resource.data);
      allow update: if owns(resource.data) && owns(request.resource.data);
    }
  }
}
